# SlotFlow Environment Configuration

# API Server
PORT=3001

# Solana RPC endpoints
SLOTFLOW_PUBLIC_RPC_URL=https://api.devnet.solana.com
SLOTFLOW_PROTECTED_RPC_URL=https://api.devnet.solana.com
SLOTFLOW_FAST_RPC_URL=https://api.devnet.solana.com

# Defaults
SLOTFLOW_DEFAULT_CONFIRMATION_TARGET=confirmed
SLOTFLOW_MAX_FEE_LAMPORTS_DEFAULT=100000
SLOTFLOW_POLL_INTERVAL_MS=2000

# Dashboard / Demo apps
NEXT_PUBLIC_API_URL=http://localhost:3001

# Mock mode for demo (deterministic mock adapters, no real RPC)
SLOTFLOW_MOCK=true
